{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bybit-quant.local/schemas/ai-paper-decision.v1.json",
  "title": "Offline AI synthetic paper contract",
  "oneOf": [
    { "$ref": "#/$defs/FixtureSnapshot" },
    { "$ref": "#/$defs/DecisionRequest" },
    { "$ref": "#/$defs/CycleReceipt" }
  ],
  "$defs": {
    "OpaqueId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "maxLength": 128 },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "DecimalText": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,18})?$", "maxLength": 38 },
    "InstrumentRules": {
      "type": "object", "additionalProperties": false,
      "required": ["base_currency", "price_increment", "size_increment", "min_quantity", "max_quantity", "min_notional"],
      "properties": {
        "base_currency": { "type": "string", "pattern": "^[A-Z0-9]{1,16}$" },
        "price_increment": { "$ref": "#/$defs/DecimalText" },
        "size_increment": { "$ref": "#/$defs/DecimalText" },
        "min_quantity": { "$ref": "#/$defs/DecimalText" },
        "max_quantity": { "$ref": "#/$defs/DecimalText" },
        "min_notional": { "$ref": "#/$defs/DecimalText" }
      }
    },
    "FixtureBar": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp_ns", "open", "high", "low", "close", "volume"],
      "properties": {
        "timestamp_ns": { "type": "integer", "minimum": 1 },
        "open": { "$ref": "#/$defs/DecimalText" },
        "high": { "$ref": "#/$defs/DecimalText" },
        "low": { "$ref": "#/$defs/DecimalText" },
        "close": { "$ref": "#/$defs/DecimalText" },
        "volume": { "$ref": "#/$defs/DecimalText" }
      }
    },
    "Candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "snapshot_id", "observed_at_ns", "expires_at_ns", "bid", "ask", "bid_size", "ask_size", "rules", "bars"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,31}$" },
        "snapshot_id": { "$ref": "#/$defs/OpaqueId" },
        "observed_at_ns": { "type": "integer", "minimum": 1 },
        "expires_at_ns": { "type": "integer", "minimum": 1 },
        "bid": { "$ref": "#/$defs/DecimalText" },
        "ask": { "$ref": "#/$defs/DecimalText" },
        "bid_size": { "$ref": "#/$defs/DecimalText" },
        "ask_size": { "$ref": "#/$defs/DecimalText" },
        "rules": { "$ref": "#/$defs/InstrumentRules" },
        "bars": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/FixtureBar" } }
      }
    },
    "CorrelationPair": {
      "type": "object", "additionalProperties": false,
      "required": ["first_symbol", "second_symbol", "coefficient"],
      "properties": {
        "first_symbol": { "type": "string", "pattern": "^[A-Z0-9]+(?:[-._][A-Z0-9]+)*$", "maxLength": 40 },
        "second_symbol": { "type": "string", "pattern": "^[A-Z0-9]+(?:[-._][A-Z0-9]+)*$", "maxLength": 40 },
        "coefficient": { "type": "string", "pattern": "^(?:-1(?:\\.0{1,18})?|0(?:\\.\\d{1,18})?|1(?:\\.0{1,18})?)$", "maxLength": 21 }
      }
    },
    "FixtureSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "fixture_id", "bundle_digest", "observed_at_ns", "expires_at_ns", "candidates", "correlations"],
      "properties": {
        "schema_version": { "const": "1" },
        "fixture_id": { "$ref": "#/$defs/OpaqueId" },
        "bundle_digest": { "$ref": "#/$defs/Sha256" },
        "observed_at_ns": { "type": "integer", "minimum": 1 },
        "expires_at_ns": { "type": "integer", "minimum": 1 },
        "candidates": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/Candidate" } },
        "correlations": { "type": "array", "maxItems": 8128, "items": { "$ref": "#/$defs/CorrelationPair" } }
      }
    },
    "DecisionTrack": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "symbol", "strategy_id", "strategy_version", "action", "target_exposure", "evidence_digest"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/OpaqueId" },
        "symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,31}$" },
        "strategy_id": { "$ref": "#/$defs/OpaqueId" },
        "strategy_version": { "$ref": "#/$defs/OpaqueId" },
        "action": { "enum": ["long", "short", "flat", "abstain"] },
        "target_exposure": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "evidence_digest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "DecisionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "environment", "request_id", "payload_digest", "session_id", "fixture_id", "bundle_digest", "cycle_id", "universe_digest", "expires_at_ns", "decision"],
      "properties": {
        "schema_version": { "const": "1" },
        "environment": { "const": "internal_paper" },
        "request_id": { "$ref": "#/$defs/OpaqueId" },
        "payload_digest": { "$ref": "#/$defs/Sha256" },
        "session_id": { "$ref": "#/$defs/OpaqueId" },
        "fixture_id": { "$ref": "#/$defs/OpaqueId" },
        "bundle_digest": { "$ref": "#/$defs/Sha256" },
        "cycle_id": { "$ref": "#/$defs/OpaqueId" },
        "universe_digest": { "$ref": "#/$defs/Sha256" },
        "expires_at_ns": { "type": "integer", "minimum": 1 },
        "decision": { "$ref": "#/$defs/DecisionTrack" }
      }
    },
    "CycleReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "payload_digest", "decision_id", "status", "reason", "command_id", "native_client_order_id"],
      "properties": {
        "schema_version": { "const": "1" },
        "request_id": { "$ref": "#/$defs/OpaqueId" },
        "payload_digest": { "$ref": "#/$defs/Sha256" },
        "decision_id": { "$ref": "#/$defs/OpaqueId" },
        "status": { "enum": ["abstained", "selected", "risk_rejected", "admitted", "accepted", "partially_filled", "filled", "protected", "unknown"] },
        "reason": { "type": ["string", "null"], "maxLength": 128 },
        "command_id": { "type": ["string", "null"], "maxLength": 128 },
        "native_client_order_id": { "type": ["string", "null"], "maxLength": 128 }
      }
    }
  }
}
