{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**"
    ],
    "production": [
      "default",
      "!{projectRoot}/test/**",
      "!{projectRoot}/docs/**"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        "^test"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        "^lint"
      ]
    }
  },
  "analytics": false
}