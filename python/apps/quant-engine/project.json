{
  "name": "quant-engine",
  "sourceRoot": "python/apps/quant-engine/src",
  "implicitDependencies": [
    "quant-data",
    "quant-risk",
    "quant-execution"
  ],
  "targets": {
    "lint": {
      "command": "uv run --project python --locked ruff check python/apps/quant-engine"
    },
    "typecheck": {
      "command": "uv run --project python --locked pyright python/apps/quant-engine"
    },
    "test": {
      "command": "uv run --project python --locked pytest python/apps/quant-engine/tests"
    },
    "serve": {
      "command": "uv run --project python --locked quant-engine",
      "cache": false
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --project python --locked quant-engine-openapi --output contracts/openapi/quant-engine.v1.json",
          "uv run --project python --locked quant-engine-openapi --paper --output contracts/openapi/quant-paper.v1.json"
        ],
        "parallel": false
      },
      "cache": false
    },
    "openapi-check": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --project python --locked quant-engine-openapi --output contracts/openapi/quant-engine.v1.json --check",
          "uv run --project python --locked quant-engine-openapi --paper --output contracts/openapi/quant-paper.v1.json --check"
        ],
        "parallel": false
      }
    }
  }
}
