{
  "name": "@local/bybit-quant",
  "version": "1.4.5",
  "private": true,
  "description": "Bybit quant toolkit for DeepSeek Harness: market data, a signal library, an AI decision track with journal scoring, a paper book, guarded live orders, and a Web panel",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "bybit",
    "quant",
    "trading",
    "ai-agent",
    "backtest"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test:unit": "node test/signals.mjs && node test/ai.mjs && node test/client.mjs && node test/render.mjs",
    "test:network": "node test/smoke.mjs && node test/integration.mjs",
    "test": "npm run test:unit && npm run test:network",
    "verify": "npm run build && npm run lint && npm run typecheck && npm run test:unit",
    "credentials": "node scripts/credentials.mjs",
    "hooks:setup": "git config core.hooksPath .githooks && echo '✓ git hooks path set to .githooks'",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxlint": "^1.94.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
