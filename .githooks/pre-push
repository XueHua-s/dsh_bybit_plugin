#!/bin/sh
# pre-push — build and run unit tests before pushing
#   Network/integration tests are intentionally skipped here (need live API keys).
#   Run `npm run test:network` manually when needed.

set -e

RED='\033[0;31m'
YEL='\033[0;33m'
GRN='\033[0;32m'
RST='\033[0m'

info()  { printf "${GRN}[pre-push]${RST} %s\n" "$1"; }
error() { printf "${RED}[pre-push] ✗ %s${RST}\n" "$1" >&2; }

# Allow skipping via env flag (useful in CI where build is a separate step)
if [ "${SKIP_PRE_PUSH:-0}" = "1" ]; then
  info "SKIP_PRE_PUSH=1 — skipping pre-push checks."
  exit 0
fi

# ── 1. Build ──────────────────────────────────────────────────────────────────
info "Building (tsup)..."
npm run build --silent || {
  error "Build failed — fix it before pushing."
  exit 1
}
info "Build succeeded."

# ── 2. TypeScript type-check ─────────────────────────────────────────────────
info "Running TypeScript type-check..."
npm run typecheck --silent || {
  error "Type-check failed — fix errors before pushing."
  exit 1
}
info "Type-check passed."

# ── 3. Unit tests ─────────────────────────────────────────────────────────────
info "Running unit tests..."
npm run test:unit || {
  error "Unit tests failed — fix them before pushing."
  printf "\n${YEL}  Network tests (npm run test:network) are not run here.${RST}\n" >&2
  exit 1
}
info "Unit tests passed."

info "All pre-push checks passed ✓"
