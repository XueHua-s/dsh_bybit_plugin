{
  "components": {
    "schemas": {
      "CommandResponse": {
        "additionalProperties": false,
        "properties": {
          "command_id": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Command Id",
            "type": "string"
          },
          "cumulative_filled": {
            "maxLength": 21,
            "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
            "title": "Cumulative Filled",
            "type": "string"
          },
          "environment": {
            "const": "internal_paper",
            "default": "internal_paper",
            "title": "Environment",
            "type": "string"
          },
          "native_client_order_id": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Native Client Order Id",
            "type": "string"
          },
          "session_id": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Session Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "admitted",
              "ready",
              "risk_rejected",
              "dispatching",
              "accepted",
              "partially_filled",
              "filled",
              "cancelled",
              "rejected",
              "reconciliation_required"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "session_id",
          "native_client_order_id",
          "state",
          "cumulative_filled"
        ],
        "title": "CommandResponse",
        "type": "object"
      },
      "PaperError": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "PaperError",
        "type": "object"
      },
      "PaperStatus": {
        "additionalProperties": false,
        "properties": {
          "environment": {
            "const": "internal_paper",
            "default": "internal_paper",
            "title": "Environment",
            "type": "string"
          },
          "generation": {
            "minimum": 0.0,
            "title": "Generation",
            "type": "integer"
          },
          "native_process_alive": {
            "title": "Native Process Alive",
            "type": "boolean"
          },
          "pending_reservations": {
            "minimum": 0.0,
            "title": "Pending Reservations",
            "type": "integer"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "session_id": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Session Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "idle",
              "running",
              "protected",
              "stopping",
              "stopped"
            ],
            "title": "State",
            "type": "string"
          },
          "synthetic": {
            "const": true,
            "default": true,
            "title": "Synthetic",
            "type": "boolean"
          }
        },
        "required": [
          "session_id",
          "state",
          "ready",
          "native_process_alive",
          "generation",
          "pending_reservations"
        ],
        "title": "PaperStatus",
        "type": "object"
      },
      "SessionRequest": {
        "additionalProperties": false,
        "properties": {
          "environment": {
            "const": "internal_paper",
            "title": "Environment",
            "type": "string"
          },
          "session_id": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "environment",
          "session_id"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "SubmitRequest": {
        "additionalProperties": false,
        "properties": {
          "environment": {
            "const": "internal_paper",
            "title": "Environment",
            "type": "string"
          },
          "limit_price": {
            "maxLength": 21,
            "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
            "title": "Limit Price",
            "type": "string"
          },
          "order_type": {
            "const": "limit",
            "title": "Order Type",
            "type": "string"
          },
          "quantity": {
            "maxLength": 21,
            "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
            "title": "Quantity",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "session_id": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Session Id",
            "type": "string"
          },
          "side": {
            "enum": [
              "buy",
              "sell"
            ],
            "title": "Side",
            "type": "string"
          },
          "symbol": {
            "const": "BTCUSDT",
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "environment",
          "session_id",
          "request_id",
          "symbol",
          "side",
          "order_type",
          "quantity",
          "limit_price"
        ],
        "title": "SubmitRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Bybit Quant Internal Paper",
    "version": "0.1.0"
  },
