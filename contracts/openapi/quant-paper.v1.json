          "command_id": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Command Id",
            "type": "string"
          },
          "cumulative_filled": {
            "maxLength": 21,
            "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?$",
            "title": "Cumulative Filled",
