#!/bin/sh
# pre-commit — lint staged src files, typecheck, block leaked secrets
set -e

RED='\033[0;31m'
YEL='\033[0;33m'
GRN='\033[0;32m'
RST='\033[0m'

info()  { printf "${GRN}[pre-commit]${RST} %s\n" "$1"; }
warn()  { printf "${YEL}[pre-commit]${RST} %s\n" "$1"; }
error() { printf "${RED}[pre-commit] ✗ %s${RST}\n" "$1" >&2; }

# ── 1. Block accidentally staged sensitive files ─────────────────────────────
SENSITIVE_PATTERNS='\.(env|pem|key|p12|pfx|secret)$|^\.env(\..+)?$|credentials\.(json|yaml|yml)$|secrets\.(json|yaml|yml)$'
STAGED_SENSITIVE=$(git diff --cached --name-only --diff-filter=ACM | grep -E "$SENSITIVE_PATTERNS" || true)
if [ -n "$STAGED_SENSITIVE" ]; then
  error "Sensitive file(s) staged — remove them before committing:"
  echo "$STAGED_SENSITIVE" | while IFS= read -r f; do
    printf "  ${RED}→ %s${RST}\n" "$f" >&2
  done
  printf "\n${YEL}  Run: git restore --staged <file>${RST}\n" >&2
  exit 1
fi

# ── 2. Block hardcoded secret patterns in staged content ─────────────────────
SECRET_PATTERNS='(api[_-]?key|secret[_-]?key|access[_-]?token|password)\s*=\s*["\x27][^"\x27]{8,}'
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|mjs|cjs)$' || true)
if [ -n "$STAGED_JS" ]; then
  SECRETS_FOUND=$(git diff --cached -- $STAGED_JS | grep '^+' | grep -v '^+++' | \
    grep -iE "$SECRET_PATTERNS" || true)
  if [ -n "$SECRETS_FOUND" ]; then
    error "Possible hardcoded secret detected in staged diff:"
    echo "$SECRETS_FOUND" >&2
    printf "\n${YEL}  Use environment variables or scripts/credentials.mjs instead.${RST}\n" >&2
    printf "  To bypass (use with caution): git commit --no-verify\n" >&2
    exit 1
  fi
fi

# ── 3. Lint staged src/ files ────────────────────────────────────────────────
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/.*\.(js|ts)$' || true)
if [ -n "$STAGED_SRC" ]; then
  info "Running oxlint on staged src files..."
  # Pass staged files explicitly so only they are checked
  npx oxlint $STAGED_SRC || {
    error "Lint failed — fix the errors above, then re-stage."
    exit 1
  }
  info "Lint passed."
else
  info "No staged src files to lint."
fi

# ── 4. TypeScript type-check ─────────────────────────────────────────────────
info "Running TypeScript type-check..."
npm run typecheck --silent || {
  error "Type-check failed — fix the errors above, then re-stage."
  exit 1
}
info "Type-check passed."

info "All pre-commit checks passed ✓"
